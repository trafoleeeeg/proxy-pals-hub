{
  "name": "umbra-desktop",
  "version": "0.4.13",
  "private": true,
  "description": "Umbra — управление антидетект-профилями",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "verify:release": "node scripts/verify-release.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "proxy-chain": "3.0.1"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "js-yaml": "5.4.2"
  },
  "build": {
    "appId": "dev.umbra.desktop",
    "productName": "Umbra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "main.cjs",
      "splash.html",
      "extensions.cjs",
      "crx.cjs",
      "extension-source.cjs",
      {
        "from": "../src",
        "to": "theme",
        "filter": [
          "styles.css"
        ]
      },
      "preload.cjs",
      "launcher.cjs",
      "fingerprint-preload.cjs",
      "proxy-check.cjs",
      "update-controller.cjs",
      "ipc-policy.cjs",
      "session-outbox.cjs",
      "runtime/**/*.cjs"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "trafoleeeeg",
        "repo": "proxy-pals-hub"
      }
    ],
    "protocols": [
      {
        "name": "Umbra",
        "schemes": [
          "umbra"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Umbra-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
