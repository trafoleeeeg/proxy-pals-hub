{
  "name": "umbra-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Umbra — управление антидетект-профилями",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.umbra.desktop",
    "productName": "Umbra",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "launcher.cjs", "fingerprint-preload.cjs"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Umbra-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
