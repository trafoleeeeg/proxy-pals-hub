 }
 
+double LocalFrame::WebExposedDevicePixelRatio() const {
+  if (!page_ || GetSettings()->GetUmbraScreenWidth() == 0) {
+    return DevicePixelRatio();
+  }
+  // LayoutZoomFactor includes host DSF. Remove it, but preserve page zoom,
+  // which is intentionally observable through CSS resolution and window DPR.
+  const float physical_scale =
+      page_->GetChromeClient().WindowToViewportScalar(&LocalFrameRoot(), 1.0f);
+  if (!(physical_scale > 0)) {
+    return GetSettings()->GetUmbraScreenDeviceScaleFactor();
+  }
+  return GetSettings()->GetUmbraScreenDeviceScaleFactor() * LayoutZoomFactor() /
+         physical_scale;
+}
