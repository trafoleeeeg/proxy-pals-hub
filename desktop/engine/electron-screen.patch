+v8::Local<v8::Promise> Session::SetUmbraFontIsolation(
+    v8::Isolate* isolate, const std::vector<base::FilePath>& files) {
+  gin_helper::Promise<void> promise(isolate);
+  auto handle = promise.GetHandle();
+#if BUILDFLAG(IS_WIN)
+  auto* preferences = SessionPreferences::FromBrowserContext(browser_context_);
+  if (preferences && preferences->isolated_fonts() &&
+      preferences->isolated_font_paths() == files) {
+    promise.Resolve();
+    return handle;
+  }
+  if (!preferences || preferences->fonts_used() || preferences->fonts_loading()) {
+    promise.RejectWithErrorMessage("Font isolation must be configured once before starting session renderers");
+    return handle;
+  }
+  if (!features::IsFontDataServiceEnabled() ||
+      base::CommandLine::ForCurrentProcess()->HasSwitch("no-sandbox") ||
+      base::CommandLine::ForCurrentProcess()->HasSwitch("single-process")) {
+    promise.RejectWithErrorMessage("Font isolation requires the sandboxed FontDataService backend");
+    return handle;
+  }
+  preferences->SetFontsLoading(true);
+  // File IO and typeface parsing must not block the browser UI sequence. The
+  // caller must await the promise before creating pages or starting workers.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&font_data_service::LoadIsolatedFontBundle, files),
+      base::BindOnce(
+          [](base::WeakPtr<ElectronBrowserContext> context,
+             std::vector<base::FilePath> paths, gin_helper::Promise<void> result,
+             std::shared_ptr<const font_data_service::IsolatedFontBundle> bundle) {
+            auto* prefs = context ? SessionPreferences::FromBrowserContext(context.get()) : nullptr;
+            if (!prefs) {
+              result.RejectWithErrorMessage("Font isolation session was destroyed");
+              return;
+            }
+            prefs->SetFontsLoading(false);
+            if (prefs->fonts_used()) {
+              result.RejectWithErrorMessage("Font isolation must finish before starting session renderers");
+              return;
+            }
+            if (!bundle) {
+              result.RejectWithErrorMessage("Invalid isolated font bundle: static Arimo, Tinos and Cousine regular fonts are required");
+              return;
+            }
+            prefs->SetIsolatedFonts(std::move(paths), std::move(bundle));
+            result.Resolve();
+          }, browser_context()->GetWeakPtr(), files, std::move(promise)));
+#else
+  promise.RejectWithErrorMessage("Font isolation is available only in the Windows experimental engine");
+#endif
+  return handle;
+}
