+// A reporting policy, not a physical display or compositor configuration.
+// Owned by BrowserContext so separate profile sessions cannot share values.
+struct UmbraScreenMetrics {
+  int width;
+  int height;
+  int available_width;
+  int available_height;
+  int color_depth;
+  double device_scale_factor;
+  bool operator==(const UmbraScreenMetrics&) const = default;
+};
+
+// Web-visible reporting only; never changes CPU scheduling or heap limits.
+struct UmbraHardwareMetrics {
+  int hardware_concurrency;
+  double device_memory;
+  bool operator==(const UmbraHardwareMetrics&) const = default;
+};
