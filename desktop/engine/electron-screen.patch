+void Session::SetUmbraScreenMetrics(gin_helper::ErrorThrower thrower,
+                                  const base::DictValue& options) {
+  const auto width = options.FindInt("width");
+  const auto height = options.FindInt("height");
+  const auto available_width = options.FindInt("availableWidth");
+  const auto available_height = options.FindInt("availableHeight");
+  const auto color_depth = options.FindInt("colorDepth");
+  const auto* scale_value = options.Find("deviceScaleFactor");
+  if (!width || !height || !available_width || !available_height ||
+      !color_depth || !scale_value ||
+      (!scale_value->is_int() && !scale_value->is_double())) {
+    thrower.ThrowTypeError("Screen metrics require all six numeric fields");
+    return;
+  }
+  const double scale = scale_value->GetDouble();
+  // The comparisons also reject NaN and infinities, without coercing strings.
+  if (*width < 320 || *width > 16384 || *height < 200 || *height > 16384 ||
+      *available_width < 1 || *available_width > *width ||
+      *available_height < 1 || *available_height > *height ||
+      *color_depth < 1 || *color_depth > 64 || !(scale >= 0.5 && scale <= 4)) {
+    thrower.ThrowRangeError("Screen metrics are outside supported bounds");
+    return;
+  }
+  auto* preferences = SessionPreferences::FromBrowserContext(browser_context_);
+  if (!preferences ||
+      !preferences->SetScreenMetrics({*width, *height, *available_width,
+                                     *available_height, *color_depth, scale})) {
+    thrower.ThrowError(
+        "Screen metrics must be configured before creating session pages");
+  }
+}
